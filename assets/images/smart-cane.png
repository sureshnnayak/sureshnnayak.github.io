<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="caneGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#7C3AED;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="aiGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="300" fill="#F8FAFC"/>
  
  <!-- Smart Cane -->
  <rect x="180" y="50" width="8" height="200" fill="url(#caneGradient)" rx="4"/>
  <circle cx="184" cy="60" r="12" fill="url(#aiGradient)"/>
  
  <!-- AI Vision Module -->
  <rect x="160" y="40" width="48" height="32" fill="url(#aiGradient)" rx="4"/>
  <circle cx="170" cy="56" r="3" fill="white"/>
  <circle cx="190" cy="56" r="3" fill="white"/>
  <rect x="175" y="60" width="18" height="2" fill="white" rx="1"/>
  
  <!-- Computer Vision Elements -->
  <g opacity="0.7">
    <circle cx="100" cy="80" r="15" fill="none" stroke="#10B981" stroke-width="2" stroke-dasharray="5,5"/>
    <circle cx="100" cy="80" r="8" fill="#10B981" opacity="0.3"/>
    <text x="100" y="85" text-anchor="middle" fill="#10B981" font-size="8" font-family="Arial">CV</text>
  </g>
  
  <!-- MDP Decision Tree -->
  <g opacity="0.7">
    <rect x="280" y="60" width="80" height="60" fill="none" stroke="#7C3AED" stroke-width="2" rx="4"/>
    <text x="320" y="80" text-anchor="middle" fill="#7C3AED" font-size="10" font-family="Arial">MDP</text>
    <text x="320" y="95" text-anchor="middle" fill="#7C3AED" font-size="8" font-family="Arial">Decision</text>
    <text x="320" y="110" text-anchor="middle" fill="#7C3AED" font-size="8" font-family="Arial">Engine</text>
  </g>
  
  <!-- Grocery Store Environment -->
  <rect x="50" y="200" width="300" height="80" fill="#E5E7EB" rx="4"/>
  <rect x="60" y="210" width="40" height="60" fill="#F3F4F6" rx="2"/>
  <rect x="110" y="210" width="40" height="60" fill="#F3F4F6" rx="2"/>
  <rect x="160" y="210" width="40" height="60" fill="#F3F4F6" rx="2"/>
  <rect x="210" y="210" width="40" height="60" fill="#F3F4F6" rx="2"/>
  <rect x="260" y="210" width="40" height="60" fill="#F3F4F6" rx="2"/>
  <rect x="310" y="210" width="40" height="60" fill="#F3F4F6" rx="2"/>
  
  <!-- Product Detection -->
  <g opacity="0.8">
    <rect x="70" y="220" width="20" height="20" fill="#10B981" opacity="0.6" rx="2"/>
    <text x="80" y="232" text-anchor="middle" fill="white" font-size="8" font-family="Arial">P1</text>
  </g>
  
  <!-- Title -->
  <text x="200" y="30" text-anchor="middle" fill="#1F2937" font-size="16" font-family="Arial" font-weight="bold">ShelfHelp: Smart Cane</text>
  <text x="200" y="290" text-anchor="middle" fill="#6B7280" font-size="12" font-family="Arial">AI-Powered Assistive Technology</text>
</svg>
