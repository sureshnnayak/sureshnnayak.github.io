<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="tomahawkGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#7C3AED;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#4C1D95;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="aiGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="300" fill="#F8FAFC"/>
  
  <!-- Tomahawk 5 Platform -->
  <rect x="50" y="80" width="300" height="140" fill="url(#tomahawkGradient)" rx="8"/>
  
  <!-- Platform Components -->
  <g>
    <!-- ACLs -->
    <rect x="70" y="100" width="60" height="40" fill="white" opacity="0.9" rx="4"/>
    <text x="100" y="120" text-anchor="middle" fill="#4C1D95" font-size="10" font-family="Arial" font-weight="bold">ACLs</text>
    <text x="100" y="135" text-anchor="middle" fill="#4C1D95" font-size="8" font-family="Arial">Access Control</text>
    
    <!-- QoS -->
    <rect x="150" y="100" width="60" height="40" fill="white" opacity="0.9" rx="4"/>
    <text x="180" y="120" text-anchor="middle" fill="#4C1D95" font-size="10" font-family="Arial" font-weight="bold">QoS</text>
    <text x="180" y="135" text-anchor="middle" fill="#4C1D95" font-size="8" font-family="Arial">Quality of Service</text>
    
    <!-- CoPP -->
    <rect x="230" y="100" width="60" height="40" fill="white" opacity="0.9" rx="4"/>
    <text x="260" y="120" text-anchor="middle" fill="#4C1D95" font-size="10" font-family="Arial" font-weight="bold">CoPP</text>
    <text x="260" y="135" text-anchor="middle" fill="#4C1D95" font-size="8" font-family="Arial">Control Plane</text>
    
    <!-- VXLAN -->
    <rect x="70" y="160" width="60" height="40" fill="white" opacity="0.9" rx="4"/>
    <text x="100" y="180" text-anchor="middle" fill="#4C1D95" font-size="10" font-family="Arial" font-weight="bold">VXLAN</text>
    <text x="100" y="195" text-anchor="middle" fill="#4C1D95" font-size="8" font-family="Arial">Virtualization</text>
    
    <!-- Telemetry -->
    <rect x="150" y="160" width="60" height="40" fill="white" opacity="0.9" rx="4"/>
    <text x="180" y="180" text-anchor="middle" fill="#4C1D95" font-size="10" font-family="Arial" font-weight="bold">Telemetry</text>
    <text x="180" y="195" text-anchor="middle" fill="#4C1D95" font-size="8" font-family="Arial">Monitoring</text>
    
    <!-- Counters -->
    <rect x="230" y="160" width="60" height="40" fill="white" opacity="0.9" rx="4"/>
    <text x="260" y="180" text-anchor="middle" fill="#4C1D95" font-size="10" font-family="Arial" font-weight="bold">Counters</text>
    <text x="260" y="195" text-anchor="middle" fill="#4C1D95" font-size="8" font-family="Arial">Infrastructure</text>
  </g>
  
  <!-- AI/ML Workloads -->
  <g opacity="0.8">
    <rect x="320" y="100" width="60" height="100" fill="url(#aiGradient)" rx="4"/>
    <text x="350" y="120" text-anchor="middle" fill="white" font-size="10" font-family="Arial" font-weight="bold">AI/ML</text>
    <text x="350" y="135" text-anchor="middle" fill="white" font-size="8" font-family="Arial">Workloads</text>
    
    <!-- AI Processing -->
    <circle cx="350" cy="160" r="8" fill="white" opacity="0.3"/>
    <text x="350" y="165" text-anchor="middle" fill="white" font-size="6" font-family="Arial">AI</text>
    
    <!-- ML Processing -->
    <circle cx="350" cy="180" r="8" fill="white" opacity="0.3"/>
    <text x="350" y="185" text-anchor="middle" fill="white" font-size="6" font-family="Arial">ML</text>
  </g>
  
  <!-- Data Flow Arrows -->
  <g stroke="#10B981" stroke-width="2" fill="none" marker-end="url(#arrowhead)">
    <line x1="130" y1="120" x2="150" y2="120"/>
    <line x1="210" y1="120" x2="230" y2="120"/>
    <line x1="130" y1="180" x2="150" y2="180"/>
    <line x1="210" y1="180" x2="230" y2="180"/>
    <line x1="290" y1="140" x2="320" y2="140"/>
  </g>
  
  <!-- Arrow marker definition -->
  <defs>
    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#10B981"/>
    </marker>
  </defs>
  
  <!-- Broadcom Logo -->
  <g transform="translate(50, 50)">
    <rect x="0" y="0" width="80" height="20" fill="#1F2937" rx="4"/>
    <text x="40" y="14" text-anchor="middle" fill="white" font-size="10" font-family="Arial" font-weight="bold">Broadcom</text>
  </g>
  
  <!-- Performance Metrics -->
  <g opacity="0.7">
    <rect x="50" y="240" width="100" height="40" fill="none" stroke="#F59E0B" stroke-width="2" rx="4"/>
    <text x="100" y="255" text-anchor="middle" fill="#F59E0B" font-size="8" font-family="Arial">High Performance</text>
    <text x="100" y="270" text-anchor="middle" fill="#F59E0B" font-size="8" font-family="Arial">Networking</text>
  </g>
  
  <!-- Platform Agnostic -->
  <g opacity="0.7">
    <rect x="250" y="240" width="100" height="40" fill="none" stroke="#3B82F6" stroke-width="2" rx="4"/>
    <text x="300" y="255" text-anchor="middle" fill="#3B82F6" font-size="8" font-family="Arial">Platform Agnostic</text>
    <text x="300" y="270" text-anchor="middle" fill="#3B82F6" font-size="8" font-family="Arial">Architecture</text>
  </g>
  
  <!-- Title -->
  <text x="200" y="30" text-anchor="middle" fill="#1F2937" font-size="16" font-family="Arial" font-weight="bold">Broadcom Tomahawk 5 Platform</text>
  <text x="200" y="290" text-anchor="middle" fill="#6B7280" font-size="12" font-family="Arial">AI/ML Networking & Platform Integration</text>
</svg>
