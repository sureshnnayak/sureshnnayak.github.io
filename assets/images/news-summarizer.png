<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <rect width="400" height="300" fill="#f8fafc"/>
  <rect x="20" y="20" width="360" height="260" fill="#ffffff" stroke="#e2e8f0" stroke-width="2" rx="8"/>
  
  <!-- Header -->
  <rect x="40" y="40" width="320" height="40" fill="#3b82f6" rx="4"/>
  <text x="200" y="65" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="16" font-weight="bold">News Summarizer</text>
  
  <!-- Content area -->
  <rect x="40" y="100" width="320" height="120" fill="#f1f5f9" rx="4"/>
  
  <!-- Article lines -->
  <rect x="60" y="120" width="280" height="8" fill="#cbd5e1" rx="4"/>
  <rect x="60" y="135" width="200" height="8" fill="#cbd5e1" rx="4"/>
  <rect x="60" y="150" width="250" height="8" fill="#cbd5e1" rx="4"/>
  <rect x="60" y="165" width="180" height="8" fill="#cbd5e1" rx="4"/>
  <rect x="60" y="180" width="220" height="8" fill="#cbd5e1" rx="4"/>
  
  <!-- Summary box -->
  <rect x="60" y="200" width="280" height="60" fill="#dcfce7" stroke="#16a34a" stroke-width="2" rx="4"/>
  <text x="200" y="220" text-anchor="middle" fill="#166534" font-family="Arial, sans-serif" font-size="12" font-weight="bold">AI Summary</text>
  <rect x="70" y="230" width="260" height="4" fill="#16a34a" rx="2"/>
  <rect x="70" y="240" width="200" height="4" fill="#16a34a" rx="2"/>
  <rect x="70" y="250" width="180" height="4" fill="#16a34a" rx="2"/>
  
  <!-- AI icon -->
  <circle cx="350" cy="50" r="15" fill="#8b5cf6"/>
  <text x="350" y="55" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="12" font-weight="bold">AI</text>
</svg>
