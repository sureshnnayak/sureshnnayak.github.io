<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <rect width="400" height="300" fill="#f8fafc"/>
  <rect x="20" y="20" width="360" height="260" fill="#ffffff" stroke="#e2e8f0" stroke-width="2" rx="8"/>
  
  <!-- Header -->
  <rect x="40" y="40" width="320" height="40" fill="#7c3aed" rx="4"/>
  <text x="200" y="65" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="16" font-weight="bold">Excalidraw Manager</text>
  
  <!-- Toolbar -->
  <rect x="40" y="90" width="320" height="30" fill="#f3f4f6" rx="4"/>
  <circle cx="60" cy="105" r="8" fill="#ef4444"/>
  <circle cx="80" cy="105" r="8" fill="#f59e0b"/>
  <circle cx="100" cy="105" r="8" fill="#10b981"/>
  <circle cx="120" cy="105" r="8" fill="#3b82f6"/>
  
  <!-- Canvas area -->
  <rect x="40" y="130" width="320" height="120" fill="#ffffff" stroke="#d1d5db" stroke-width="1" rx="4"/>
  
  <!-- Diagram elements -->
  <!-- Rectangle -->
  <rect x="80" y="150" width="80" height="50" fill="none" stroke="#374151" stroke-width="2" rx="4"/>
  <text x="120" y="175" text-anchor="middle" fill="#374151" font-family="Arial, sans-serif" font-size="10">Process</text>
  
  <!-- Arrow -->
  <line x1="160" y1="175" x2="200" y2="175" stroke="#374151" stroke-width="2" marker-end="url(#arrowhead)"/>
  
  <!-- Circle -->
  <circle cx="240" cy="175" r="25" fill="none" stroke="#374151" stroke-width="2"/>
  <text x="240" y="180" text-anchor="middle" fill="#374151" font-family="Arial, sans-serif" font-size="10">Decision</text>
  
  <!-- Arrow marker definition -->
  <defs>
    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#374151"/>
    </marker>
  </defs>
  
  <!-- Sidebar -->
  <rect x="280" y="130" width="80" height="120" fill="#f9fafb" stroke="#d1d5db" stroke-width="1" rx="4"/>
  <text x="320" y="150" text-anchor="middle" fill="#374151" font-family="Arial, sans-serif" font-size="10" font-weight="bold">Tools</text>
  
  <!-- Tool icons -->
  <rect x="290" y="160" width="20" height="15" fill="none" stroke="#6b7280" stroke-width="1" rx="2"/>
  <rect x="310" y="160" width="20" height="15" fill="none" stroke="#6b7280" stroke-width="1" rx="2"/>
  <circle cx="300" cy="185" r="8" fill="none" stroke="#6b7280" stroke-width="1"/>
  <line x1="290" y1="200" x2="310" y2="200" stroke="#6b7280" stroke-width="2"/>
  
  <!-- Footer -->
  <rect x="40" y="260" width="320" height="20" fill="#f1f5f9" rx="4"/>
  <text x="200" y="273" text-anchor="middle" fill="#6b7280" font-family="Arial, sans-serif" font-size="10">Hand-drawn style diagrams</text>
</svg>
