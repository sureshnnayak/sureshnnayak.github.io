<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="uavGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#1D4ED8;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cvGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10B981;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#059669;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- Background -->
  <rect width="400" height="300" fill="#F8FAFC"/>
  
  <!-- UAV System -->
  <g transform="translate(200, 120)">
    <!-- Main Body -->
    <ellipse cx="0" cy="0" rx="30" ry="15" fill="url(#uavGradient)"/>
    
    <!-- Propellers -->
    <g>
      <!-- Front Left -->
      <circle cx="-25" cy="-20" r="8" fill="#6B7280" opacity="0.7"/>
      <line x1="-25" y1="-20" x2="-25" y2="-28" stroke="#6B7280" stroke-width="2"/>
      <line x1="-25" y1="-20" x2="-17" y2="-20" stroke="#6B7280" stroke-width="2"/>
      
      <!-- Front Right -->
      <circle cx="25" cy="-20" r="8" fill="#6B7280" opacity="0.7"/>
      <line x1="25" y1="-20" x2="25" y2="-28" stroke="#6B7280" stroke-width="2"/>
      <line x1="25" y1="-20" x2="33" y2="-20" stroke="#6B7280" stroke-width="2"/>
      
      <!-- Rear Left -->
      <circle cx="-25" cy="20" r="8" fill="#6B7280" opacity="0.7"/>
      <line x1="-25" y1="20" x2="-25" y2="28" stroke="#6B7280" stroke-width="2"/>
      <line x1="-25" y1="20" x2="-17" y2="20" stroke="#6B7280" stroke-width="2"/>
      
      <!-- Rear Right -->
      <circle cx="25" cy="20" r="8" fill="#6B7280" opacity="0.7"/>
      <line x1="25" y1="20" x2="25" y2="28" stroke="#6B7280" stroke-width="2"/>
      <line x1="25" y1="20" x2="33" y2="20" stroke="#6B7280" stroke-width="2"/>
    </g>
    
    <!-- Camera/Gimbal -->
    <circle cx="0" cy="-10" r="6" fill="url(#cvGradient)"/>
    <rect x="-2" y="-12" width="4" height="4" fill="white" opacity="0.8"/>
  </g>
  
  <!-- Computer Vision Processing -->
  <g opacity="0.8">
    <rect x="50" y="50" width="80" height="60" fill="url(#cvGradient)" rx="4"/>
    <text x="90" y="75" text-anchor="middle" fill="white" font-size="12" font-family="Arial" font-weight="bold">Computer</text>
    <text x="90" y="90" text-anchor="middle" fill="white" font-size="12" font-family="Arial" font-weight="bold">Vision</text>
    <text x="90" y="105" text-anchor="middle" fill="white" font-size="10" font-family="Arial">OpenCV</text>
  </g>
  
  <!-- Object Detection -->
  <g opacity="0.7">
    <rect x="270" y="50" width="80" height="60" fill="none" stroke="#10B981" stroke-width="2" rx="4"/>
    <text x="310" y="75" text-anchor="middle" fill="#10B981" font-size="12" font-family="Arial" font-weight="bold">Object</text>
    <text x="310" y="90" text-anchor="middle" fill="#10B981" font-size="12" font-family="Arial" font-weight="bold">Detection</text>
    <text x="310" y="105" text-anchor="middle" fill="#10B981" font-size="10" font-family="Arial">Neural Networks</text>
  </g>
  
  <!-- Survey Area -->
  <rect x="50" y="200" width="300" height="80" fill="#E5E7EB" rx="4"/>
  <rect x="70" y="220" width="40" height="40" fill="#F3F4F6" rx="2"/>
  <rect x="120" y="220" width="40" height="40" fill="#F3F4F6" rx="2"/>
  <rect x="170" y="220" width="40" height="40" fill="#F3F4F6" rx="2"/>
  <rect x="220" y="220" width="40" height="40" fill="#F3F4F6" rx="2"/>
  <rect x="270" y="220" width="40" height="40" fill="#F3F4F6" rx="2"/>
  <rect x="320" y="220" width="40" height="40" fill="#F3F4F6" rx="2"/>
  
  <!-- Detected Objects -->
  <g opacity="0.8">
    <rect x="80" y="230" width="20" height="20" fill="#10B981" opacity="0.6" rx="2"/>
    <text x="90" y="242" text-anchor="middle" fill="white" font-size="8" font-family="Arial">O1</text>
    
    <rect x="180" y="230" width="20" height="20" fill="#10B981" opacity="0.6" rx="2"/>
    <text x="190" y="242" text-anchor="middle" fill="white" font-size="8" font-family="Arial">O2</text>
    
    <rect x="280" y="230" width="20" height="20" fill="#10B981" opacity="0.6" rx="2"/>
    <text x="290" y="242" text-anchor="middle" fill="white" font-size="8" font-family="Arial">O3</text>
  </g>
  
  <!-- Data Flow Arrows -->
  <g stroke="#10B981" stroke-width="2" fill="none" marker-end="url(#arrowhead)">
    <line x1="130" y1="80" x2="200" y2="120"/>
    <line x1="200" y1="120" x2="270" y2="80"/>
    <line x1="200" y1="120" x2="200" y2="200"/>
  </g>
  
  <!-- Arrow marker definition -->
  <defs>
    <marker id="arrowhead" markerWidth="10" markerHeight="7" refX="9" refY="3.5" orient="auto">
      <polygon points="0 0, 10 3.5, 0 7" fill="#10B981"/>
    </marker>
  </defs>
  
  <!-- Package Delivery -->
  <g opacity="0.7">
    <rect x="50" y="240" width="60" height="30" fill="none" stroke="#F59E0B" stroke-width="2" rx="4"/>
    <text x="80" y="255" text-anchor="middle" fill="#F59E0B" font-size="8" font-family="Arial">Package</text>
    <text x="80" y="265" text-anchor="middle" fill="#F59E0B" font-size="8" font-family="Arial">Delivery</text>
  </g>
  
  <!-- Autonomous Navigation -->
  <g opacity="0.7">
    <rect x="290" y="240" width="60" height="30" fill="none" stroke="#3B82F6" stroke-width="2" rx="4"/>
    <text x="320" y="255" text-anchor="middle" fill="#3B82F6" font-size="8" font-family="Arial">Autonomous</text>
    <text x="320" y="265" text-anchor="middle" fill="#3B82F6" font-size="8" font-family="Arial">Navigation</text>
  </g>
  
  <!-- Title -->
  <text x="200" y="30" text-anchor="middle" fill="#1F2937" font-size="16" font-family="Arial" font-weight="bold">Autonomous UAV System</text>
  <text x="200" y="290" text-anchor="middle" fill="#6B7280" font-size="12" font-family="Arial">Computer Vision & Object Detection</text>
</svg>

