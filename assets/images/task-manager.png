<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <rect width="400" height="300" fill="#f8fafc"/>
  <rect x="20" y="20" width="360" height="260" fill="#ffffff" stroke="#e2e8f0" stroke-width="2" rx="8"/>
  
  <!-- Header -->
  <rect x="40" y="40" width="320" height="40" fill="#059669" rx="4"/>
  <text x="200" y="65" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="16" font-weight="bold">Task Manager</text>
  
  <!-- Add task input -->
  <rect x="40" y="90" width="250" height="30" fill="#f9fafb" stroke="#d1d5db" stroke-width="1" rx="4"/>
  <text x="50" y="110" fill="#6b7280" font-family="Arial, sans-serif" font-size="12">Add new task...</text>
  <rect x="300" y="90" width="60" height="30" fill="#3b82f6" rx="4"/>
  <text x="330" y="110" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="12" font-weight="bold">Add</text>
  
  <!-- Task list -->
  <rect x="40" y="130" width="320" height="120" fill="#ffffff" stroke="#e5e7eb" stroke-width="1" rx="4"/>
  
  <!-- Task items -->
  <rect x="50" y="140" width="300" height="25" fill="#fef3c7" stroke="#f59e0b" stroke-width="1" rx="4"/>
  <circle cx="60" cy="152" r="6" fill="none" stroke="#f59e0b" stroke-width="2"/>
  <text x="75" y="157" fill="#92400e" font-family="Arial, sans-serif" font-size="11">Complete project documentation</text>
  <text x="320" y="157" fill="#92400e" font-family="Arial, sans-serif" font-size="10">High</text>
  
  <rect x="50" y="170" width="300" height="25" fill="#dbeafe" stroke="#3b82f6" stroke-width="1" rx="4"/>
  <circle cx="60" cy="182" r="6" fill="#3b82f6"/>
  <text x="75" y="187" fill="#1e40af" font-family="Arial, sans-serif" font-size="11">Review code changes</text>
  <text x="320" y="187" fill="#1e40af" font-family="Arial, sans-serif" font-size="10">Medium</text>
  
  <rect x="50" y="200" width="300" height="25" fill="#f3e8ff" stroke="#8b5cf6" stroke-width="1" rx="4"/>
  <circle cx="60" cy="212" r="6" fill="none" stroke="#8b5cf6" stroke-width="2"/>
  <text x="75" y="217" fill="#6b21a8" font-family="Arial, sans-serif" font-size="11">Update dependencies</text>
  <text x="320" y="217" fill="#6b21a8" font-family="Arial, sans-serif" font-size="10">Low</text>
  
  <rect x="50" y="230" width="300" height="25" fill="#fce7f3" stroke="#ec4899" stroke-width="1" rx="4"/>
  <circle cx="60" cy="242" r="6" fill="none" stroke="#ec4899" stroke-width="2"/>
  <text x="75" y="247" fill="#be185d" font-family="Arial, sans-serif" font-size="11">Plan team meeting</text>
  <text x="320" y="247" fill="#be185d" font-family="Arial, sans-serif" font-size="10">Medium</text>
  
  <!-- Progress bar -->
  <rect x="40" y="260" width="320" height="8" fill="#e5e7eb" rx="4"/>
  <rect x="40" y="260" width="200" height="8" fill="#10b981" rx="4"/>
  <text x="200" y="255" text-anchor="middle" fill="#374151" font-family="Arial, sans-serif" font-size="10">Progress: 60%</text>
</svg>
