<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <rect width="400" height="300" fill="#f8fafc"/>
  <rect x="20" y="20" width="360" height="260" fill="#ffffff" stroke="#e2e8f0" stroke-width="2" rx="8"/>
  
  <!-- Browser header -->
  <rect x="20" y="20" width="360" height="30" fill="#f1f5f9" rx="8"/>
  <circle cx="40" cy="35" r="4" fill="#ef4444"/>
  <circle cx="55" cy="35" r="4" fill="#f59e0b"/>
  <circle cx="70" cy="35" r="4" fill="#10b981"/>
  
  <!-- Navigation -->
  <rect x="40" y="60" width="320" height="30" fill="#3b82f6" rx="4"/>
  <text x="200" y="80" text-anchor="middle" fill="white" font-family="Arial, sans-serif" font-size="14" font-weight="bold">Portfolio Website</text>
  
  <!-- Hero section -->
  <rect x="40" y="100" width="320" height="60" fill="#f8fafc" stroke="#e2e8f0" stroke-width="1" rx="4"/>
  <text x="200" y="125" text-anchor="middle" fill="#1f2937" font-family="Arial, sans-serif" font-size="16" font-weight="bold">Welcome to My Portfolio</text>
  <text x="200" y="145" text-anchor="middle" fill="#6b7280" font-family="Arial, sans-serif" font-size="12">Software Engineer & Content Creator</text>
  
  <!-- Content cards -->
  <rect x="60" y="180" width="100" height="60" fill="#fef3c7" stroke="#f59e0b" stroke-width="1" rx="4"/>
  <text x="110" y="200" text-anchor="middle" fill="#92400e" font-family="Arial, sans-serif" font-size="10" font-weight="bold">Projects</text>
  <rect x="70" y="210" width="80" height="3" fill="#f59e0b" rx="1"/>
  <rect x="70" y="220" width="60" height="3" fill="#f59e0b" rx="1"/>
  
  <rect x="180" y="180" width="100" height="60" fill="#dbeafe" stroke="#3b82f6" stroke-width="1" rx="4"/>
  <text x="230" y="200" text-anchor="middle" fill="#1e40af" font-family="Arial, sans-serif" font-size="10" font-weight="bold">Articles</text>
  <rect x="190" y="210" width="80" height="3" fill="#3b82f6" rx="1"/>
  <rect x="190" y="220" width="70" height="3" fill="#3b82f6" rx="1"/>
  
  <rect x="300" y="180" width="100" height="60" fill="#f3e8ff" stroke="#8b5cf6" stroke-width="1" rx="4"/>
  <text x="350" y="200" text-anchor="middle" fill="#6b21a8" font-family="Arial, sans-serif" font-size="10" font-weight="bold">Resume</text>
  <rect x="310" y="210" width="80" height="3" fill="#8b5cf6" rx="1"/>
  <rect x="310" y="220" width="65" height="3" fill="#8b5cf6" rx="1"/>
  
  <!-- Footer -->
  <rect x="40" y="250" width="320" height="20" fill="#f1f5f9" rx="4"/>
  <text x="200" y="263" text-anchor="middle" fill="#6b7280" font-family="Arial, sans-serif" font-size="10">© 2024 Suresh Nayak</text>
</svg>
